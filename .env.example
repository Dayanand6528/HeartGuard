# HeartGuard Email Notification Settings (SMTP Configuration)
# Rename or copy this file to .env or set environment variables in your terminal/system.

# 1. SMTP Provider Settings (Default is Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 2. Sender Account Credentials (Email used to send out the message)
SENDER_EMAIL=your_email@gmail.com
# For Gmail: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SENDER_PASSWORD=your_16_character_app_password

# 3. Destination Inbox (Where you want to RECEIVE all contact form submissions)
RECEIVER_EMAIL=your_personal_or_admin_email@gmail.com
